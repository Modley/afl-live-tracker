# Copy to .env and adjust as needed

# "squiggle" polls the real public Squiggle AFL API (https://api.squiggle.com.au)
# "mock" runs a built-in match simulator - useful for development/demo when
# there is no live AFL match in progress, or to test the pipeline offline.
DATA_SOURCE=squiggle

# How often to poll for updates, in milliseconds.
# Squiggle's own scrapers refresh scores roughly every 15-60s during live play,
# so polling much faster than 10000 (10s) will not get you fresher data - it
# will just hammer their free API. Please be a good citizen: keep this >= 10000.
POLL_INTERVAL_MS=15000

# Squiggle asks API consumers to identify themselves via a descriptive
# User-Agent header that includes a way to contact you. Please fill this in
# with your own app name / email before deploying anywhere public.
SQUIGGLE_USER_AGENT=afl-live-tracker (contact: your-email@example.com)

# Port the backend HTTP + WebSocket server listens on
PORT=4000

# Comma-separated list of origins allowed to connect (CORS). Use * for any
# (fine for local dev, tighten for production).
CORS_ORIGIN=*
